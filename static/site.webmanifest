{
  "name": "Furezu - Phrasebook",
  "short_name": "Furezu",
  "description": "a simple Phrasebook for travel.",
  "start_url": "/",
  "scope": "/",
  "id": "com.siddheshmangela.furezu",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#7259FF",
  "background_color": "#7259FF",
  "categories": ["Travel", "Phrasebook", "Languages"],
  "lang": "en-US",
  "dir": "ltr",
  "prefer_related_applications": false,
  "file_handlers": [
     {
       "action": "/actions/import",
       "accept": {
         "application/vnd.furezu": [".furezu"]
       }
     }
   ],
  "icons": [
    {
      "src": "/assets/icons/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/assets/screenshots/screenshot-1.png",
      "sizes": "640x320",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Home light"
    },
    {
      "src": "/assets/screenshots/screenshot-2.png",
      "sizes": "370x639",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Home light mobile"
    }
  ]
}